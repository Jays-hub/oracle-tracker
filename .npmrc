# Promote an `engines` mismatch from a warning to a hard install failure.
#
# Without this, npm only prints EBADENGINE and installs anyway — so a wrong Node
# surfaces later as a confusing jsdom/Vitest failure instead of "wrong Node".
# The range in package.json is the intersection of our dependencies' own
# `engines`; jsdom is the binding constraint (see README "Requirements").
engine-strict=true
